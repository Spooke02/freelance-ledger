PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional AI. Any OpenAI-compatible endpoint works, e.g. Google Gemini (free tier key from aistudio.google.com):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=<a current Gemini model name>
# AI_API_KEY=
# Local Ollama needs no key: AI_BASE_URL=http://127.0.0.1:11434/v1  AI_MODEL=<a model you have pulled>
# Or Anthropic: ANTHROPIC_API_KEY=
